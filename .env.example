# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (ja esta no .gitignore).

DATASOURCE_URL=jdbc:mysql://localhost:3306/help_desk?createDatabaseIfNotExist=true
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=your_mysql_password

# Credenciais SMTP (ex: Mailtrap - Email Testing / sandbox).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# String aleatoria longa (min. 32 caracteres) usada pra assinar/validar o JWT.
# Gere a sua, nunca reaproveite a de outro projeto ou exemplo.
JWT_SECRET=generate_your_own_random_secret_min_32_chars
